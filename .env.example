# Environment variables declared in this file are NOT automatically loaded by Prisma CLI directly —
# prisma.config.ts imports "dotenv/config" so these load for `prisma` CLI commands.
# Next.js loads .env automatically for `next dev` / `next build`.

# --- Database (Supabase Postgres) ---
# Both URLs use the Supavisor pooler host (same host Supabase shows you on the
# "Connection Pooling" tab) — NOT db.<ref>.supabase.co. That direct hostname
# resolves to an IPv6-only address unless you've bought Supabase's IPv4 add-on,
# and most CI runners / serverless build environments have no IPv6 egress, so
# `prisma migrate deploy` (or anything else) using it will hang or fail to
# connect there. The Session Pooler below is IPv4-reachable and still supports
# the advisory locks Migrate needs, so use it for DIRECT_URL instead.

# Transaction mode (port 6543) — used by the app at runtime (src/lib/db.ts).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session mode (port 5432) — used only by `prisma migrate` (needs advisory locks pgbouncer's transaction mode can't provide).
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (media uploads) ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"
SUPABASE_STORAGE_BUCKET="devos-media"

# --- Admin auth ---
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
SESSION_SECRET="replace-with-a-long-random-string"
