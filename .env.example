# Environment variables declared in this file are NOT automatically loaded by Prisma CLI directly —
# prisma.config.ts imports "dotenv/config" so these load for `prisma` CLI commands.
# Next.js loads .env automatically for `next dev` / `next build`.

# --- Database (Neon Postgres) ---
# Single connection string, used for both the app at runtime (src/lib/db.ts) and
# for `prisma migrate`/`prisma db seed`. Use the direct (non-pooled) connection
# string from the Neon dashboard — NOT the "-pooler" host — since this app's
# traffic is low enough that PgBouncer pooling isn't needed, and `prisma migrate`
# requires a direct connection anyway (its advisory locks aren't supported by
# PgBouncer's transaction-mode pooler).
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require"

# --- Vercel Blob (media uploads) ---
# Read-write token for the project's Blob store. Create a Blob store under the
# Storage tab of the Vercel project, then run `vercel env pull` to fetch this
# locally, or copy it from the store's dashboard.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"

# --- Admin auth ---
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
SESSION_SECRET="replace-with-a-long-random-string"
